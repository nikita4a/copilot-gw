# copilot-gw configuration template.
# Copy to .env and fill in. Never commit .env (it is gitignored).

# Optional bearer key the gateway requires on inbound requests.
# Leave empty to disable auth (open gateway — local/testing only).
GATEWAY_KEY=

# TCP port the gateway listens on.
PORT=8787

# --- Puter provider (third upstream, gpt-6-luna/astra/sol, claude-*, ~1030 models)
# Token: https://puter.com -> DevTools -> Local Storage -> key `auth_token`.
# Provider is enabled by default once a token is present; set PUTER_ENABLED=false
# to keep copilot-only routing.
PUTER_AUTH_TOKEN=
# Optional pool: comma-separated tokens, round-robin (429 rotates).
PUTER_AUTH_TOKENS=

# Explicit on/off override (default: on iff PUTER_AUTH_TOKEN is set).
PUTER_ENABLED=

# Route models unknown to the copilot listing and present in the puter catalog
# to puter. Default off — deterministic routing wins.
PUTER_FALLBACK=false

# Catalog cache TTL for /v1/models (seconds).
PUTER_MODELS_TTL_SECONDS=600

# --- Vercel AI Gateway provider (fourth provider, OpenAI-compat, vendor/model ids)
# Key: https://vercel.com/dashboard/ai-gateway (free $5/month credits on a new
# key, no card). Empty key = provider disabled: /v1/models has no vercel: entries
# and a vercel:<model> request answers 400, copilot routing is untouched.
AI_GATEWAY_API_KEY=

# Explicit on/off override (default: on iff AI_GATEWAY_API_KEY is set).
VERCEL_ENABLED=

# Catalog cache TTL for GET /v1/models (seconds, default 1h).
VERCEL_MODELS_TTL_SECONDS=3600

# Upstream request timeout (seconds).
VERCEL_TIMEOUT_SECONDS=120

# Base override (default https://ai-gateway.vercel.sh/v1).
# VERCEL_AI_GATEWAY=https://ai-gateway.vercel.sh/v1

# --- Default routing (no prefix on /v1/chat/completions)
# vercel (id found in its catalog) -> puter (needs PUTER_FALLBACK=true) ->
# copilot. Set VERCEL_ENABLED=false to make copilot the default again; ask for
# copilot explicitly per request with the `github:` prefix.