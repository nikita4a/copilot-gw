# copilot-gw configuration template.
# Copy to .env and fill in. Never commit .env (it is gitignored).

# Optional bearer key the gateway requires on inbound requests.
# Leave empty to disable auth (open gateway — local/testing only).
GATEWAY_KEY=

# TCP port the gateway listens on.
PORT=8787

# --- Puter provider (third upstream, gpt-6-luna/astra/sol, claude-*, ~1030 models)
# Token: https://puter.com -> DevTools -> Local Storage -> key `auth_token`.
# Provider is enabled by default once a token is present; set PUTER_ENABLED=false
# to keep copilot-only routing.
PUTER_AUTH_TOKEN=
# Optional pool: comma-separated tokens, round-robin (429 rotates).
PUTER_AUTH_TOKENS=

# Explicit on/off override (default: on iff PUTER_AUTH_TOKEN is set).
PUTER_ENABLED=

# Route models unknown to the copilot listing and present in the puter catalog
# to puter. Default off — deterministic routing wins.
PUTER_FALLBACK=false

# Catalog cache TTL for /v1/models (seconds).
PUTER_MODELS_TTL_SECONDS=600